rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // 댓글 차단 — comment_bans/{학번} 문서가 있으면 그 학생은 댓글을 쓸 수 없다.
    // 화면(index.js)에서도 같은 문서를 보고 입력칸을 접지만, 콘솔로 직접 쏘는 길까지
    // 막으려면 여기서도 봐야 한다. 문서 읽기가 한 번 더 붙지만 댓글은 드물게 쓰인다.
    function cmBanned(sid) {
      return exists(/databases/$(database)/documents/comment_bans/$(sid));
    }

    // ── 관리자 전용 콘텐츠 (허브/미션 카드, 각종 설정, 강의·성적 관리) ──
    match /cards/{id}                          { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}                       { allow read: if true; allow write: if isAdmin(); }
    match /lms_items/{id}                      { allow read: if true; allow write: if isAdmin(); }
    match /class_lessons/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /grade_records/{id}                  { allow read: if true; allow write: if isAdmin(); }
    // 논술형 수행평가 점수·피드백(문서 id = 학번). 채점은 전적으로 선생님 몫이라 쓰기는 어드민만.
    match /essay_records/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /grade_publish_status/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /grade_lecture_config/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /grade_settings/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /gradeOverrides/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /think_lectures/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /escape26_2/{id}                     { allow read: if true; allow write: if isAdmin(); }
    match /escape26_2_settings/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /silla_settings/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /survey_config/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /samguk_goods/{id}                   { allow read: if true; allow write: if isAdmin(); }
    match /ox2606_questions/{id}               { allow read: if true; allow write: if isAdmin(); }
    // OX 퀴즈 문제은행(ox/admin.html에서 등록·엑셀 업로드). 학생은 읽기만 한다.
    match /ox_questions/{id}                   { allow read: if true; allow write: if isAdmin(); }

    // ── 학생 자가제출: 생성(및 명시된 항목만 수정)은 공개 허용하되 필드를 검증한다.
    //    수정/삭제는 이 블록에서 허용하지 않는 한 맨 아래 catch-all(관리자 전용)로 넘어간다.
    //    학생은 Firebase Auth로 로그인하지 않으므로 "본인 문서"임을 암호학적으로
    //    증명할 방법이 없다 — 아래 검증은 명백히 잘못된 쓰기(크기 폭주, 관리자 필드
    //    조작)를 막는 수준이며, 완전한 본인 확인은 규칙만으로는 불가능하다.

    match /think_submissions/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.id is string &&
        request.resource.data.name is string && request.resource.data.name.size() <= 50 &&
        request.resource.data.text is string && request.resource.data.text.size() <= 5000 &&
        request.resource.data.isPicked == false &&
        // 채점 관련 필드를 스스로 달고 제출할 수는 없다. thGraded를 미리 켜 버리면
        // 아래 update 잠금에 스스로 걸려 고쳐 쓰지 못하고, AI 채점 대상에서도 빠진다.
        !request.resource.data.keys().hasAny([
          'thGraded', 'aiPt', 'aiScore', 'aiVerdict', 'xpAwarded', 'xpAwardedAt', 'editCount'
        ])
      );
      // 고쳐 쓰기 / 다시 제출 —
      //  · 채점이 끝난 제출물(thGraded == true)은 잠근다. 채점 결과와 답이 어긋나면 안 되고,
      //    포인트도 이미 지급된 뒤다. 선생님이 "채점 취소"를 누르면 thGraded가 false로
      //    돌아가면서 학생이 다시 고칠 수 있게 된다.
      //  · createdAt은 바꿀 수 없다. 최초 제출 시각이 밀리면 수업 당일에 낸 학생이
      //    나중에 오타 하나 고쳤다는 이유로 "지연 제출"로 뒤집힌다.
      //  · 채점 결과 필드(aiVerdict/thGraded/aiPt/isPicked)는 목록에서 빼 교사 전용으로 남긴다.
      allow update: if isAdmin() || (
        (!('thGraded' in resource.data) || resource.data.thGraded != true) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.text is string && request.resource.data.text.size() <= 5000 &&
        request.resource.data.isPicked == resource.data.isPicked &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lectureDocId', 'lectureTitle', 'name', 'text', 'textLength', 'duration',
          'cheatCount', 'aiHintUsed', 'spellFlagged', 'spellFixed', 'hasProfanity',
          // pasteTry: 붙여넣기(드롭 포함)를 막은 횟수. maxJump: 한 번에 늘어난 최대 글자수.
          // 둘 다 부정행위 참고용 기록이며 채점 결과와 무관하다.
          'pasteTry', 'maxJump',
          'source', 'editedAt', 'editCount'
        ])
      );
    }

    // ── 사화 소감(문서 id = 학번) ──
    //    수업을 마친 학생이 남기는 글. 결석해서 게임을 못 한 학생도 남길 수 있어
    //    선생님은 이 글로 활동 여부를 가린다. 학번당 한 장이고 다시 내면 덮어쓴다.
    //    읽기를 열어 두는 것은 다른 컬렉션과 같은 방침이다(학생 화면은 자기 글만 불러온다).
    match /sahwa_reflections/{sid} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.studentId == sid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        request.resource.data.keys().hasOnly([
          'studentId', 'name', 'classNum', 'ho', 'text', 'updatedAt'
        ])
      );
    }

    // ── 공지 열람 기록 + 좋아요 ──
    //    문서 ID는 "공지ID_학번". 학생은 자기 열람 기록을 만들고 좋아요만 켰다 껐다 한다.
    //    수정 시 누구의 기록인지(studentId)는 못 바꾸게 고정한다.
    match /announcement_reads/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string && request.resource.data.studentName.size() <= 50 &&
        request.resource.data.annId is string &&
        request.resource.data.liked is bool
      );
      allow update: if isAdmin() || (
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.annId == resource.data.annId &&
        request.resource.data.liked is bool &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['liked', 'likedAt', 'readAt', 'studentName', 'classNum'])
      );
    }

    // ── 공지 댓글 ──
    //    누구나 읽는다(같은 반이 서로 본다). 쓰기는 글자 수와 필드를 묶어 두고,
    //    고치는 길은 두지 않는다 — 지우고 다시 쓰면 되고, 지워도 포인트는 한 번뿐이다.
    //    지우기는 선생님과 글쓴이 본인만.
    // 차단된 학생(comment_bans/{학번})은 새 댓글을 쓸 수 없다. 이미 쓴 글은 그대로 두고,
    // 지우는 길도 막지 않는다 — 스스로 거둘 수는 있어야 한다.
    match /announcement_comments/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.annId is string &&
        request.resource.data.studentId is string && request.resource.data.studentId.size() <= 10 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 50 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.keys().hasOnly(
          ['annId', 'studentId', 'name', 'classNum', 'text', 'createdAt']) &&
        // 맨 끝에 둔다 — 여기서만 문서를 한 번 더 읽으므로, 형식이 틀린 요청은
        // 그 앞의 값 검사에서 걸러져 읽기 값을 쓰지 않는다.
        !cmBanned(request.resource.data.studentId)
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || resource.data.studentId is string;
    }

    // 댓글 차단 명단(문서 id = 학번). 학생 화면이 자기 차단 여부를 구독하므로 읽기는 열고,
    // 걸고 푸는 일은 선생님만 한다.
    match /comment_bans/{studentId}            { allow read: if true; allow write: if isAdmin(); }

    match /lms_auth/{studentId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.keys().hasOnly(['pw']) &&
        request.resource.data.pw is string && request.resource.data.pw.size() <= 100
      );
    }

    match /lms_consent/{studentId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['agreedAt', 'name']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 50
      );
    }

    match /survey_responses/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string && request.resource.data.studentName.size() <= 50 &&
        request.resource.data.answers is map
      );
    }

    match /escape26_2_reflections/{studentId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.reflection is string && request.resource.data.reflection.size() <= 3000
      );
    }

    match /silla_v3/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string &&
        request.resource.data.keywords is list && request.resource.data.keywords.size() <= 5 &&
        request.resource.data.adPick == false &&
        request.resource.data.newsLikes.size() == 0 &&
        request.resource.data.adLikes.size() == 0
      );
      // 다른 학생의 좋아요 토글(newsLikes/adLikes만 변경) 또는 본인 기사 재작성 허용
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['newsLikes']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adLikes']) ||
        (
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.keywords is list && request.resource.data.keywords.size() <= 5
        );
    }

    match /interview_joseon_answers/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.answers is map
      );
    }

    match /interview_joseon_deep/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.question is string && request.resource.data.question.size() <= 2000
      );
    }

    match /interview_joseon_deep_reply/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.replyText is string && request.resource.data.replyText.size() <= 2000
      );
    }

    // ── 조선 전기 과학 전시관 (j_science): 카드 제출 + 투표 ──
    match /j_science_cards/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.heritageId is string &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
      );
    }

    match /j_science_votes/{voterId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.voterId == voterId &&
        request.resource.data.targetStudentId is string &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 600
      );
    }

    // ── 사화 네컷 (j_4cut): 완성 작품 자동 제출 + 친구 작품 좋아요 ──
    //    문서 id가 곧 학번이다 — 1인 1장을 구조로 강제하고, 다시 만들면 덮어쓴다.
    //    그림 본문은 여기 없다(fourcut_images로 뺐다). 갤러리와 어드민이 목록을 만들 때
    //    문서를 통째로 받는데, 그림까지 들어 있으면 한 건이 750KB라 160명이면 117MB가
    //    오갔다. 여기는 1.5KB짜리 메타데이터만 두고 그림은 보는 것만 따로 가져온다.
    match /fourcut_works/{studentId} {
      allow read: if true;

      //    첫 제출. 채점 결과(status)와 픽(picked)은 선생님만 쓰므로 학생 쪽에서는 아예 못 싣는다.
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.studentId == studentId &&
        request.resource.data.studentName is string && request.resource.data.studentName.size() <= 50 &&
        request.resource.data.likes == 0 &&
        !request.resource.data.keys().hasAny(['status', 'picked'])
      );

      allow update: if isAdmin()
        //  좋아요는 다른 학생이 누르므로 likes/likedBy만 바꾸는 수정을 따로 연다.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        //  다시 만들어 낸 경우. 받은 좋아요는 그대로 두고 대사와 배치만 갈아끼운다.
        //  status와 picked는 반드시 지워 선생님이 새 내용을 다시 보게 한다 — 통과나 픽을
        //  받은 뒤 내용을 바꿔치기하는 걸 막는 장치다.
        || (
          request.resource.data.studentId == studentId &&
          request.resource.data.likes == resource.data.likes &&
          request.resource.data.likedBy == resource.data.likedBy &&
          !request.resource.data.keys().hasAny(['status', 'picked'])
        );

      //  어드민의 작품 삭제. 여기에 delete가 없어서 그동안 삭제 버튼이 막혀 있었다.
      allow delete: if isAdmin();
    }

    //    작품 그림 본문(base64 JPEG). 목록을 가볍게 두려고 작품 문서에서 떼어 냈다.
    //    문서 id는 작품과 같은 학번이라 짝이 저절로 맞는다. 좋아요나 채점 같은 건 여기
    //    없으므로 학생은 자기 그림만 쓰고, 지우는 건 선생님만 한다.
    match /fourcut_images/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.image is string &&
        request.resource.data.keys().hasOnly(['studentId', 'image', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    //    LMS 성적 체크의 미션 자동 연동이 읽는 제출 요약(이미지 없음, 학번당 1문서).
    //    작품 문서는 이미지 때문에 무거워 전량 조회를 못 하므로 이걸 따로 남긴다.
    //    채점 결과(status)는 선생님만 쓸 수 있다 — 학생 쪽 쓰기는 제출 사실만 남긴다.
    match /fourcut_submissions/{studentId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string && request.resource.data.studentName.size() <= 50 &&
        !request.resource.data.keys().hasAny(['status'])
      );
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['studentId', 'studentName', 'classNum', 'lastAt', 'createdAt', 'status']) &&
        //  status는 지우는 것만 허용 — pass/fail로 설정하는 건 여전히 선생님 전용이다.
        (!('status' in request.resource.data) || request.resource.data.status == null)
      );
    }

    // ── 역사 도미노 (j_wartimeline): 순서 맞추기 + 인과 잇기 결과 ──
    match /j_wartimeline_results/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        (!('status' in request.resource.data) || resource == null || request.resource.data.status == resource.data.status)
      );
    }

    match /ox2606_rankings/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.score is number && request.resource.data.score <= 1000000 &&
        request.resource.data.comment == ''
      );
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment']) &&
        request.resource.data.comment is string && request.resource.data.comment.size() <= 200
      );
    }

    match /ox2606_sessions/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.score is number && request.resource.data.score <= 1000000
      );
    }

    // ── OX 퀴즈 (ox/): 학생별 누적 요약 + 풀이 한 건씩 ──
    //    요약은 문서 id가 곧 학번이라 1인 1장이 구조로 강제된다. 어드민 목록은 이 요약만
    //    읽고, 세션은 학생을 펼칠 때만 읽는다(학기가 갈수록 세션이 쌓이므로).
    //    포인트 지급은 여기가 아니라 RTDB의 xp 트랜잭션이 하므로, points 필드는 화면에
    //    보여 주는 사본일 뿐이다 — 이 값을 부풀려도 실제 경험치는 늘지 않는다.
    match /ox_records/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.sid == studentId &&
        request.resource.data.name is string && request.resource.data.name.size() <= 50 &&
        request.resource.data.sessions is number && request.resource.data.sessions <= 100000 &&
        request.resource.data.correct is number && request.resource.data.correct <= 1000000 &&
        request.resource.data.total is number && request.resource.data.total <= 1000000 &&
        request.resource.data.lessons is map && request.resource.data.lessons.size() <= 100
      );
      allow delete: if isAdmin();
    }

    match /ox_sessions/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.sid is string &&
        request.resource.data.lessonNum is string &&
        request.resource.data.correct is number && request.resource.data.correct <= 1000 &&
        request.resource.data.total is number && request.resource.data.total <= 1000
      );
      allow delete: if isAdmin();
    }

    match /ox2606_corrections/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000
      );
    }

    // ── 미션 제출 (학생 비로그인 쓰기 허용, 필드 검증 포함) ──────────────────

    match /s_threads_posts/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.content is string && request.resource.data.content.size() <= 1000 &&
        request.resource.data.likes == 0 &&
        !('adminPick' in request.resource.data) &&
        !('status' in request.resource.data)
      );
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'edited']) &&
          request.resource.data.content is string && request.resource.data.content.size() <= 1000
        );
    }

    match /goryeo_choice_results/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.reflection is string && request.resource.data.reflection.size() <= 600 &&
        !('pick' in request.resource.data) &&
        !('status' in request.resource.data)
      );
    }

    match /blind_ryeo_posts/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.studentId is string &&
        request.resource.data.content is string && request.resource.data.content.size() <= 300 &&
        request.resource.data.likes == 0 &&
        !('adminPick' in request.resource.data) &&
        !('status' in request.resource.data)
      );
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'edited']) &&
          request.resource.data.content is string && request.resource.data.content.size() <= 300
        );
    }

    // ── 유교로 나라를 다스린다는 것 (j_yugyo): 카드 분류 + 서술 ──
    match /j_yugyo_sorts/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.placements is map
      );
    }

    match /j_yugyo_essays/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
        // status(통과/미흡 채점)는 교사(관리자)만 설정 — 학생 쓰기에서 변경 불가
        (!('status' in request.resource.data) || resource == null || request.resource.data.status == resource.data.status)
      );
    }

    // ── 그 외 모든 경로(레거시/미사용 컬렉션 포함): 읽기는 공개, 쓰기는 관리자만.
    //    위에서 create/update만 허용한 학생 자가제출 컬렉션의 delete도 여기로 떨어져
    //    관리자 전용이 된다.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
